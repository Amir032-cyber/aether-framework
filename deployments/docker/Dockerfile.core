FROM rust:1.82-bookworm AS build
WORKDIR /app
COPY . .
RUN cargo build --release -p aether-core
FROM debian:bookworm-slim
RUN useradd --system --create-home aether
COPY --from=build /app/target/release/aether-core /usr/local/bin/aether-core
USER aether
EXPOSE 8080
CMD ["/usr/local/bin/aether-core"]
