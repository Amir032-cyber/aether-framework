# AETHER Configuration
AETHER_LOG_LEVEL=info
AETHER_API_PORT=8080
AETHER_GRPC_PORT=50051

# Database
DATABASE_URL=sqlite:aether.db
REDIS_URL=redis://localhost:6379

# AI Keys (Don't commit real keys)
OPENAI_API_KEY=your_key_here
